rules_version = '2';

// Scorekortene ligger i samlingen "spil", ét dokument pr. spilkode.
// Standard: kun anonymt/logget ind adgang — slå "Anonymous" til under
// Firebase Console → Authentication → Sign-in method.
service cloud.firestore {
  match /databases/{database}/documents {
    match /spil/{kode} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
